{
  "name": "howlongwillitlast",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:ui": "vite --host 127.0.0.1",
    "build": "npm run typecheck && tsc -p tsconfig.server.json && vite build",
    "start": "node dist/server/server.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && vue-tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests e2e scripts *.ts *.json *.yaml .github/workflows/*.yml",
    "format:check": "prettier --check src tests e2e scripts *.ts *.json *.yaml .github/workflows/*.yml"
  },
  "dependencies": {
    "@fastify/static": "^10.1.7",
    "@primeuix/themes": "^1.2.5",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "echarts": "^6.1.0",
    "fastify": "^5.12.7",
    "primevue": "^4.5.5",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "6.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
