# Optional production settings. Development compose needs no .env.
PROXY_NETWORK=proxy
IMAGE_TAG=latest
APP_URL=https://howlong.example.com
OIDC_ISSUER_URL=https://identity.example.com/realms/example
OIDC_CLIENT_ID=howlongwillitlast
OIDC_CLIENT_SECRET=
OIDC_EMAIL_DOMAINS=example.com
# Generate this locally; never commit real credentials or the generated secret.
# openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH2_PROXY_COOKIE_SECRET=
# Set server variables in the shell (development) or compose environment (Docker).
# AUTH_MODE=development
# DATABASE_PATH=data/app.sqlite
# IDENTITY_HEADER=x-forwarded-user
